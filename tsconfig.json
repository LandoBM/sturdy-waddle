{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleSuffixes": [".ios", ".android", ".native", ".web", ""]
  },
  "include": [
    "App.tsx",
    "native/**/*.ts",
    "native/**/*.tsx",
    "src/data.ts",
    "src/posts.ts",
    "src/trips.ts"
  ]
}

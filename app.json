{
  "expo": {
    "name": "Outside",
    "slug": "outside-fitapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.outside.fitapp",
      "supportsTablet": false
    },
    "android": {
      "package": "com.outside.fitapp",
      "permissions": [
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Outside to attach photos to your posts.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Outside uses your location while you record a hike or run.",
          "locationAlwaysAndWhenInUsePermission": "Outside uses your location during an activity, including when the screen is locked, so your route and distance keep recording.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Outside imports completed workouts and related metrics that you choose to share from Apple Health.",
          "NSHealthUpdateUsageDescription": false
        }
      ],
      "react-native-health-connect",
      "./plugins/withHealthConnectQueries",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}

{
  "expo": {
    "name": "Outside",
    "slug": "outside-fitapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Outside to attach photos to your posts.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
